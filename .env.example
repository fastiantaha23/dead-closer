# Copy to .env for local runs. NEVER commit the real .env or paste keys into the repo.
# On the host (Hugging Face Space / Render) set these as *secrets* / environment variables instead.

# --- LLM (required for the Claude-powered mode; without it the agent runs on its offline rules engine)
ANTHROPIC_API_KEY=
DEADCLOSER_MODEL=claude-haiku-5-5
DEADCLOSER_LLM=auto            # auto = Claude when ANTHROPIC_API_KEY is set, rules otherwise | claude | rules

# --- Storage: a free hosted Postgres (Neon or Supabase). Memory is persisted here (messages, long-term memory, checkpoints).
# Neon:      postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
# Supabase:  postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres
DATABASE_URL=

# --- App
DEADCLOSER_ADMIN_KEY=          # protects /admin/* and the admin dashboard (choose a long random string)
CHAT_TENANT=demo_realty        # business the public /chat agent represents: demo_realty (site visits) | demo_motors (test drives)
CORS_ORIGINS=*                 # set to your website origin, e.g. https://dead-closer.vercel.app
PORT=7860                      # Hugging Face Spaces uses 7860; Render injects its own PORT

# --- Local development only (used when DATABASE_URL is empty)
# DEADCLOSER_DB=data/deadcloser.db
# DEADCLOSER_CHECKPOINTS=data/checkpoints.db
